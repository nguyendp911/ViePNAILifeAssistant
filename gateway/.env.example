PORT=8787
VIEPN_GATEWAY_TOKEN=replace-with-random-secret-at-least-24-chars
VIEPN_DATA_FILE=./data/state.json
AI_API_URL=https://your-provider.example/v1/chat/completions
AI_API_KEY=your-server-side-secret
AI_MODEL=your-model-id
# V4.8: optional native Google Gemini on the gateway. Set model ID you have enabled.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional extra server-side OpenAI-compatible/Gemini providers and model allowlist.
# No API keys are shipped in the iOS app.
# VIEPN_AI_PROVIDERS_JSON=[{"id":"custom","name":"My private model","kind":"openai","endpoint":"https://provider.example/v1/chat/completions","key":"SERVER_SIDE_ONLY","models":["model-id-1","model-id-2"]}]

# Enable on an always-on server; schedules create approval requests only.
VIEPN_AUTOMATION_POLL=false

# V3.2: optional multiple accounts (replaces VIEPN_GATEWAY_TOKEN when configured).
# Generate independent 32+ character random tokens. Never commit real tokens.
# VIEPN_ACCOUNTS_JSON=[{"id":"user1","displayName":"User 1","token":"INSERT_RANDOM_TOKEN_32_OR_MORE_CHARS"}]

# V3.3: PostgreSQL enables registration, login, seven-day sessions and isolated JSONB user data.
# When DATABASE_URL is empty the V3.2 token-based local development mode remains enabled.
DATABASE_URL=
# Use encrypted Postgres connections in production; configure CA trust as appropriate.
PGSSL=require

# V3.6 Google integration (optional). Keep secrets on Gateway, never in the IPA.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-gateway.example/v1/integrations/google/callback
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# V3.7 optional semantic vector search. Without these settings the app keeps lexical search.
# This server-side provider receives document chunks ONLY when the user requests indexing.
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
